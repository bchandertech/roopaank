{
  "name": "roopaank",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @roopaank/web",
    "lint": "npm run lint --workspaces --if-present",
