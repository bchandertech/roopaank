# Copy to .env for local development. Never commit .env.
# Staging and production set these in the hosting platform, with their own values.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local Docker Postgres (docker compose up -d db). Local-only credentials.
DATABASE_URL=postgresql://roopaank:roopaank@localhost:5434/roopaank
# Used by `npm test`; defaults to this value if unset.
TEST_DATABASE_URL=postgresql://roopaank:roopaank@localhost:5434/roopaank_test

# The web app's origin: the only origin allowed by CORS and the CSRF origin check.
WEB_ORIGIN=http://localhost:5173

# Number of reverse proxies in front of the API (0 locally, usually 1 when hosted).
TRUST_PROXY=0

SESSION_TTL_DAYS=30

# Razorpay TEST mode keys from https://dashboard.razorpay.com (Settings → API Keys / Webhooks).
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# Product image storage (local disk until S3 — D11).
UPLOAD_DIR=uploads
PUBLIC_UPLOADS_URL=http://localhost:4000/uploads

# Used only by `npm run admin:create`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
