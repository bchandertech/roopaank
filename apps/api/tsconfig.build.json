{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Production build uses the compiled @roopaank/shared (dist), so no "source" condition.
    "customConditions": [],
    "types": ["node"],
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
